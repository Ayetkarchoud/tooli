# Copy this file to .env and adjust if needed (.env is never committed).
# Every value has a default in docker-compose.yml, so .env is optional for a first run.
# Never put real passwords or keys in this example file.

# Ports on your computer
CLIENT_PORT=5173
SERVER_PORT=5000
MONGO_PORT=27017

# Where Vite forwards /api/* (inside Docker the API is the "server" service)
API_PROXY_TARGET=http://server:5000

# Express API (used once the server service exists)
MONGODB_URI=mongodb://mongo:27017/tooli
JWT_SECRET=change-me-to-a-long-random-string
